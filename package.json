{
  "name": "abcds-rf",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ABCDS-RF Digital Application — POCI site selection and ABCD Scorecard for palm-oil community development assessment (CPOPC Output 11)",
  "scripts": {
